// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                  @id @default(cuid())
  passwordHash         String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  categories           Category[]
  entries              TimeEntry[]
  notificationPrefs    NotificationPreferences?
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  color        String        @default("#64748B")
  order        Int           @default(0)
  isSystem     Boolean       @default(false)
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  entries      TimeEntry[]

  @@index([userId, archived])
  @@index([userId, order])
}

model Subcategory {
  id         String      @id @default(cuid())
  categoryId String
  name       String
  order      Int         @default(0)
  archived   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  entries    TimeEntry[]

  @@index([categoryId, archived])
}

model TimeEntry {
  id              String       @id @default(cuid())
  userId          String
  date            String       // "YYYY-MM-DD" — stored as date-only, no UTC drift
  startMinute     Int          // 0–1439 (minutes since midnight)
  durationMinutes Int          // 1–60 per hourly block
  categoryId      String
  subcategoryId   String?
  note            String?
  isUnaccounted   Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category     @relation(fields: [categoryId], references: [id])
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@index([userId, date])
  @@index([userId, date, startMinute])
  @@index([userId, categoryId])
}

model NotificationPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  enabled         Boolean  @default(false)
  frequency       String   @default("none") // "none"|"1h"|"2h"|"few"
  pushSubscription String?  // JSON stringified push subscription
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
